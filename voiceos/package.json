{
	"name": "voiceos",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot src/main.ts",
		"start": "bun src/main.ts",
		"test": "bun test src evals",
		"test:live": "VOICEOS_LIVE=1 bun test test/live",
		"typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
		"evals": "bun evals/run.ts",
		"fixtures": "bun scripts/gen-audio-fixtures.ts",
		"install-dev": "bun scripts/install-dev.ts",
		"check": "biome check . && eslint .",
		"format": "biome check --write . && eslint --fix ."
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.282",
		"@anthropic-ai/sdk": "^0.128.0",
		"@modelcontextprotocol/sdk": "^1.30.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/bun": "^1.4.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^8.57",
		"playwright": "^1.63.0",
		"typescript": "^5.9",
		"typescript-eslint": "^8.70.1",
		"typescript-native": "npm:typescript@^7.0.2"
	}
}
